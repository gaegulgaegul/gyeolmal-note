---
import Layout from "./Layout.astro";
import config from "@/config";

type Props = {
  title?: string;
  /** 글 제목 그대로(사이트명 접미사 없이). JSON-LD headline 에 쓴다 */
  headline?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
};

const { site } = config;

const {
  title,
  headline,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
} = Astro.props;

const pageURL = canonicalURL ?? new URL(Astro.url.pathname, Astro.site).href;

// 결말노트는 개인이 아니라 사이트 명의로 쓰므로 author·publisher 모두 같은 Organization
const organization = {
  "@type": "Organization",
  "@id": new URL("#organization", site.url).href,
  name: site.title,
  url: site.url,
};

// 수정 이력이 없으면 발행일이 곧 마지막 수정일이다
const lastModified = modDatetime ?? pubDatetime;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: headline ?? title ?? site.title,
  ...(description && { description }),
  image: ogImage,
  url: pageURL,
  mainEntityOfPage: { "@type": "WebPage", "@id": pageURL },
  inLanguage: site.lang,
  ...(pubDatetime && { datePublished: pubDatetime.toISOString() }),
  ...(lastModified && { dateModified: lastModified.toISOString() }),
  author: organization,
  publisher: organization,
};
---

<Layout {title} {description} {ogImage} {canonicalURL} ogType="article">
  <Fragment slot="head">
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <slot />
</Layout>
